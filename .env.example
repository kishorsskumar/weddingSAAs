# Backend Environment Variables
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/database_name

# Authentication
JWT_SECRET=your-secure-jwt-secret-key-change-in-production

# Server Configuration
PORT=3000
NODE_ENV=production

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Default Admin Account (only used on first run)
DEFAULT_ADMIN_EMAIL=admin@yourcompany.com
DEFAULT_ADMIN_PASSWORD=YourSecurePassword123!
DEFAULT_ADMIN_NAME=Super Admin

# Company Branding (optional)
COMPANY_NAME=Your Company Name
COMPANY_SHORT_NAME=YourCo
COMPANY_EMAIL=contact@yourcompany.com
COMPANY_PHONE=+1234567890
COMPANY_WEBSITE=https://yourcompany.com
COMPANY_ADDRESS=Your Business Address

# Document Prefixes (optional)
DOC_PREFIX_EVENT=EVT
DOC_PREFIX_CUSTOMER=CUST
DOC_PREFIX_ESTIMATE=EST
DOC_PREFIX_INVOICE=INV

# Theme (optional)
THEME_PRIMARY_COLOR=135 35% 30%
THEME_PRIMARY_HEX=#5B8C51

# Regional Settings (optional)
CURRENCY=INR
CURRENCY_SYMBOL=₹
DEFAULT_COUNTRY=India
TIMEZONE=Asia/Kolkata

# Feature Flags (optional)
FEATURE_WHATSAPP=false
FEATURE_AI_ASSISTANT=false
FEATURE_GOOGLE_CALENDAR=false
FEATURE_RSVP=false

# WhatsApp Integration (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# AI Assistant (optional)
OPENAI_API_KEY=

# Google Calendar Integration (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
